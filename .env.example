# Environment variables (local / CI examples)

# Databricks (bundle deploy + Jobs API poller / dispatch)
# DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# LLM (LiteLLM)
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Postgres app state (Lakebase or Neon)
# DATABASE_URL=postgresql://user:pass@host:5432/aiops
# Or Lakebase discrete vars (JWT via: databricks database generate-database-credential):
# LAKEBASE_HOST=ep-....database.us-east-2.cloud.databricks.com
# LAKEBASE_USER=you@example.com
# LAKEBASE_DB=databricks_postgres
# LAKEBASE_PASSWORD=
# LAKEBASE_INSTANCE=aiops-lakebase

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GitHub commit correlation (read-only)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=tidkesandeep/autonomous-ai-ops-platform
